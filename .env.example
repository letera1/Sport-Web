# ============================================================
# PUBLIC (VITE_*) — bundled into the browser. Never put secrets here.
# ============================================================

# TheSportsDB (keyless free tier) — stays the default provider
VITE_API_BASE_URL=/api/v1/json/3
VITE_PREMIER_LEAGUE_ID=4328

# Team highlighted across the app. Uses the official provider team ID, not a name.
VITE_MY_TEAM_ID=133604
VITE_MY_TEAM_NAME=Arsenal

# ============================================================
# SERVER-ONLY — never prefixed with VITE_, never sent to the browser.
# Local: put the real value in .env (git-ignored).
# Production: set in Vercel → Project → Settings → Environment Variables.
# ============================================================

# Your SportDB.dev API key. REQUIRED to enable SportDB features.
SPORTDB_API_KEY=

# Optional overrides (safe defaults applied when omitted)
# SPORTDB_BASE_URL=https://api.sportdb.dev
# Hard ceiling on upstream calls per window. The free tier is ~100-1000 LIFETIME
# requests, so keep this low until you are on a paid plan.
# SPORTDB_REQUEST_BUDGET=800
# SPORTDB_BUDGET_WINDOW_MS=2592000000
# Comma-separated. Only these sports may be requested at all.
# SPORTDB_ALLOWED_SPORTS=football
# SPORTDB_TIMEOUT_MS=10000
# SPORTDB_MAX_RETRIES=2
# Per-IP limit against our own endpoint
# SPORTDB_RL_WINDOW_MS=60000
# SPORTDB_RL_MAX=30
